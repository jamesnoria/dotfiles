{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@slkiser/opencode-quota"
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "disabled": false,
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/github_token}"
        }
      }
    }
  }
}
